# Production environment for the Leak Quote App.
# Copy to /srv/leakquote/.env on the server and fill in real values.
# Never commit the filled-in file.

# --- Required -------------------------------------------------------------

# The app refuses to start without this.
DATABASE_URL=postgresql://leakquote:CHANGE_ME@localhost:5432/leakquote

# Signing key for session cookies. Generate with:  openssl rand -base64 48
# The app THROWS ON BOOT in production if this is unset, rather than falling
# back to a default that would make every session forgeable.
SESSION_SECRET=

# From https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Switches on secure cookies AND proxy trust. Behind nginx without this,
# secure cookies are never set and the login rate limiter buckets every
# request under the proxy's single address.
NODE_ENV=production

# The exact public HTTPS origin. If this does not match, CORS blocks the
# browser and the session cookie will not stick.
WEB_ORIGIN=https://quotes.swcconstruction.com.sg

# --- Optional -------------------------------------------------------------

PORT=4000

# Only if LibreOffice is somewhere unusual. Normally found on PATH.
# SOFFICE_PATH=/usr/bin/soffice
